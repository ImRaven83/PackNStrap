<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Description>Guards WTTClientCommonLib's CustomParent attribute scan against unrelated broken assemblies in the mod list</Description>
        <PluginGuid>com.packnstrap.wtt-reflectionguard</PluginGuid>
        <PluginName>PackNStrap-WTT-ReflectionGuard</PluginName>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Configurations>Debug;Release;UNITY_EDITOR</Configurations>
        <RootNamespace>PackNStrapWttCompat</RootNamespace>
        <PackageId>PackNStrap-WTT-ReflectionGuard</PackageId>
    </PropertyGroup>

    <Target Name="GeneratePluginConstants" BeforeTargets="CoreCompile">
        <ItemGroup>
            <PluginSource Include="namespace $(RootNamespace)%3B" />
            <PluginSource Include="internal static class PluginConstants" />
            <PluginSource Include="{" />
            <PluginSource Include="    public const string Guid = &quot;$(PluginGuid)&quot;%3B" />
            <PluginSource Include="    public const string Name = &quot;$(PluginName)&quot;%3B" />
            <PluginSource Include="    public const string Version = &quot;$(Version)&quot;%3B" />
            <PluginSource Include="}" />
        </ItemGroup>

        <WriteLinesToFile File="$(IntermediateOutputPath)PluginConstants.g.cs" Lines="@(PluginSource)" Overwrite="true" />

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)PluginConstants.g.cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>..\..\..\BepInEx\core\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>..\..\..\BepInEx\core\BepInEx.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="@echo off&#xA;setlocal enabledelayedexpansion&#xA;&#xA;REM Set variables&#xA;set MODNAME=$(TargetName)&#xA;set DLLPATH=$(TargetDir)$(TargetName).dll&#xA;set OUTDIR=..\..\..\BepInEx\plugins\WTT-PackNStrap&#xA;set BUILDOUTDIR=..\Build\BepInEx\plugins\WTT-PackNStrap&#xA;&#xA;REM Create output directories if they don't exist&#xA;if not exist &quot;%OUTDIR%&quot; mkdir &quot;%OUTDIR%&quot;&#xA;if not exist &quot;%BUILDOUTDIR%&quot; mkdir &quot;%BUILDOUTDIR%&quot;&#xA;&#xA;REM Copy the DLL to BepInEx plugins directory&#xA;copy /Y &quot;%DLLPATH%&quot; &quot;%OUTDIR%\&quot; &gt;nul 2&gt;&amp;1&#xA;echo [PostBuild] Copied %MODNAME%.dll to %OUTDIR%&#xA;&#xA;REM Copy the DLL to Build/BepInEx plugins directory&#xA;copy /Y &quot;%DLLPATH%&quot; &quot;%BUILDOUTDIR%\&quot; &gt;nul 2&gt;&amp;1&#xA;echo [PostBuild] Copied %MODNAME%.dll to %BUILDOUTDIR%&#xA;&#xA;echo [PostBuild] BepInEx build output: %OUTDIR% and %BUILDOUTDIR%&#xA;endlocal&#xA;" />
    </Target>

</Project>
